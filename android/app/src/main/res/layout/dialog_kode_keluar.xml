<?xml version="1.0" encoding="utf-8"?>
<!--
    Layar kode keluar. Kotak angka dan keypad dibuat oleh DialogKodeKeluar;
    keypad sendiri dipakai, bukan keyboard sistem, supaya tidak ada aplikasi
    keyboard pihak ketiga yang terbuka selama ujian.
    ScrollView menjaga layar tetap utuh di HP berlayar pendek.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tombol_tutup"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tombol_ikon"
                android:contentDescription="@string/keluar_batal"
                android:padding="10dp"
                android:src="@drawable/ic_tutup"
                android:tint="@color/tinta" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/label_identitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/redup2"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <FrameLayout
            android:id="@+id/lingkaran_ikon"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_lingkaran_ikon">

            <ImageView
                android:id="@+id/ikon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gembok"
                android:tint="@color/jingga" />
        </FrameLayout>

        <TextView
            android:id="@+id/judul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/keluar_judul"
            android:textColor="@color/tinta"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subjudul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:maxWidth="320dp"
            android:text="@string/keluar_pesan"
            android:textColor="@color/redup"
            android:textSize="14.5sp" />

        <LinearLayout
            android:id="@+id/baris_digit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/pesan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/jingga_tua"
                android:textSize="13.5sp" />

            <ProgressBar
                android:id="@+id/memeriksa"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/jingga"
                android:visibility="gone" />
        </FrameLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <!-- Lebarnya dibatasi di kode (paling lebar 360dp) supaya keypad tidak
             melebar berlebihan di tablet. -->
        <LinearLayout
            android:id="@+id/papan_angka"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
