<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol Keluar di bilah gelap: garis krem, isi transparan. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/riak_terang">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke android:width="1.5dp" android:color="@color/krem" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</ripple>
